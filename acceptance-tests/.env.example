# Copia este archivo como .env y completa los valores de tu entorno QA.
# Este archivo de ejemplo no contiene credenciales reales.
APP_BASE_URL=http://localhost:5173

QA_ADMIN_USERNAME=
QA_ADMIN_PASSWORD=

# Completa con datos QA que existan en tu ambiente. Si se dejan vacíos,
# se usan los valores predeterminados definidos para las pruebas de Sergio.
QA_PADRON_CARRERA=INGENIERÍA DE SISTEMAS
QA_PASANTIA_PENDIENTE_TITULO=[QA Sergio] Moderación rechazar
QA_PASANTIA_SIN_APLICANTES_TITULO=[QA Sergio] Oferta sin aplicantes
